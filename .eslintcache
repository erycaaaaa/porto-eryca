ies array to be: [TOC]",{"range":"375","text":"376"},"suggestUnknown",{"range":"377","text":"378"},"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct.","suggestNever",{"range":"379","text":"380"},"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of.","Wrap the definition of 'startTimers' in its own useCallback() Hook.",{"range":"381","text":"382"},"Update the dependencies array to be: [defaultDurationMs, maxTotalMs, oncePerSession, startTimers]",{"range":"383","text":"384"},{"range":"385","text":"373"},[1399,1410],"[active, pathname, q, router, sp]",[2947,2958],[2067,2069],"[TOC]",[7209,7212],"unknown",[7209,7212],"never",[882,1129],"useCallback((durMs: number) => {\r\n    clearTimers();\r\n    setVisible(true);\r\n    hideTimerRef.current = window.setTimeout(() => setVisible(false), durMs);\r\n    maxTimerRef.current = window.setTimeout(() => setVisible(false), Math.max(durMs, maxTotalMs));\r\n  })",[1471,1518],"[defaultDurationMs, maxTotalMs, oncePerSession, startTimers]",[1516,1527]]